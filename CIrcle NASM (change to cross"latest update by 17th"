bits 32

section .bss
    input   resb 16          ; buffer for the number the user types

section .data
    msg     db "Enter radius (example 8 or 10): ", 0
    len     equ $ - msg - 1  ; length without the 0

    star    db "* "
    space   db "  "
    newline db 10

section .text
    global _start

_start:
    ; ----- print the message -----
    mov eax, 4
    mov ebx, 1
    mov ecx, msg
    mov edx, len
    int 0x80

    ; ----- read what the user types -----
    mov eax, 3              ; sys_read
    mov ebx, 0              ; stdin
    mov ecx, input
    mov edx, 16
    int 0x80                ; eax now = how many bytes were read

    ; ----- convert the text "10" into the real number 10 -----
    xor ebp, ebp            ; ebp will become the radius (start at 0)
    mov esi, input          ; esi points to the text the user typed

convert:
    movzx eax, byte [esi]   ; get one character
    cmp al, 10              ; is it Enter (newline)?
    je  done_convert
    cmp al, '0'
    jb  done_convert
    cmp al, '9'
    ja  done_convert

    sub al, '0'             ; turn '5' into the number 5
    imul ebp, 10            ; radius = radius * 10
    add ebp, eax            ; radius = radius + digit
    inc esi
    jmp convert

done_convert:
    ; now ebp contains the real radius number the user typed

    ; ----- calculate r² -----
    mov eax, ebp
    mul eax                 ; eax = r * r
    mov edi, eax            ; edi = r²

    ; ----- start Y from -radius -----
    mov esi, ebp
    neg esi                 ; esi = -radius

; ==================== Y LOOP (rows) ====================
y_loop:
    mov ecx, ebp
    neg ecx                 ; ecx = -radius   (start of X)

; ==================== X LOOP (columns) ====================
x_loop:
    ; calculate x² + y²
    mov eax, ecx
    imul eax, eax           ; x²

    mov ebx, esi
    imul ebx, ebx           ; y²

    add eax, ebx            ; x² + y²

    ; |x² + y² - r²|
    sub eax, edi
    jns positive
    neg eax
positive:

    cmp eax, 12             ; thickness (you can change 8~15)
    ja  print_space

    ; ----- print star -----
    mov eax, 4
    mov ebx, 1
    mov edx, 2              ; "* " is 2 characters
    push ecx
    mov ecx, star
    int 0x80
    pop ecx
    jmp next_x

print_space:
    mov eax, 4
    mov ebx, 1
    mov edx, 2              ; "  " is 2 characters
    push ecx
    mov ecx, space
    int 0x80
    pop ecx

next_x:
    inc ecx
    cmp ecx, ebp
    jle x_loop              ; next column

    ; ----- end of row → print newline -----
    mov eax, 4
    mov ebx, 1
    mov ecx, newline
    mov edx, 1
    int 0x80

    ; ----- next row -----
    inc esi
    cmp esi, ebp
    jle y_loop

    ; ----- exit -----
    mov eax, 1
    xor ebx, ebx
    int 0x80
